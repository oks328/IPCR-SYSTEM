# =========================
# Python Compiled Files
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual Environments
# =========================
# (Never push the environment, only the requirements.txt)
venv/
env/
.venv/
.env/
env.bak/
venv.bak/

# =========================
# Environment Variables & Secrets
# =========================
# (This is the most critical part to keep your DB passwords safe)
.env
.env.local
.env.*

# =========================
# Local Databases
# =========================
# (If you are using SQLite for local testing, don't push it so you 
# and your team don't overwrite each other's test data)
*.sqlite3
db.sqlite3

# =========================
# OS Generated Files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# File Uploads / Media
# =========================
# (Ignore the actual PDF/Image evidence files uploaded during testing)
media/
uploads/